{
  "name": "spotter-app",
  "version": "1.6.0",
  "description": "Standalone Mac app embedding ThoughtSpot Spotter",
  "main": "src/main/main.js",
  "scripts": {
    "start": "webpack --mode development && electron .",
    "dev": "webpack --mode development --watch & electron .",
    "build": "webpack --mode production",
    "lint": "eslint .",
    "pack": "webpack --mode production && electron-builder --mac --publish never",
    "release": "webpack --mode production && electron-builder --mac --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.thoughtspot.spotter",
    "productName": "Spotter",
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": true
    },
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thoughtspot",
        "repo": "spotter-desktop"
      }
    ],
    "files": [
      "src/main/**/*",
      "build/**/*"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.0",
    "@fontsource/inter": "^5.2.8",
    "@thoughtspot/visual-embed-sdk": "^1.52.0",
    "app-builder-bin": "^4.2.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "dotenv": "^17.4.2",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.11.0",
    "html-webpack-plugin": "^5.6.0",
    "iconv-corefoundation": "^1.1.7",
    "mixpanel-browser": "^2.82.0",
    "playwright-core": "^1.60.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "style-loader": "^3.3.4",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
